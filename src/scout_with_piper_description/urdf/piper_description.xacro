<?xml version="1.0" encoding="utf-8"?>

<robot name="piper" xmlns:xacro="http://ros.org/wiki/xacro">

<xacro:arg name="left_camera_xyz" default="0 0 0" />
<xacro:arg name="left_camera_rpy" default="0 0 0" />

<!-- arm: agx_arm_urdf/piper (official DAE visuals, link names prefixed) -->



<link name="piper_base_link">>

        <inertial>

            <origin xyz="-0.00473641164191482 2.56829134630247E-05 0.041451518036016" rpy="0 0 0"/>

            <mass value="1.02" />

            <inertia ixx="0.00267433" ixy="-0.00000073" ixz="-0.00017389" iyy="0.00282612" iyz="0.0000004" izz="0.00089624"/>

        </inertial>

        <visual>

            <origin xyz="0 0 0" rpy="0 0 0"/>

            <geometry>

                <mesh filename="package://scout_with_piper_description/meshes/base_link.dae"/>

            </geometry>
      <material name="piper_body">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>

        </visual>

        <collision>

            <origin xyz="0 0 0" rpy="0 0 0"/>

            <geometry>

                <mesh filename="package://scout_with_piper_description/meshes/base_link.stl"/>

            </geometry>

        </collision>

    </link>

    <link name="piper_link1">>

        <inertial>

            <origin xyz="0.00032 -0.00041 -0.00348" rpy="0 0 0"/>

            <mass value="0.71"/>

            <inertia ixx="0.00050027" ixy="0.00000078" ixz="0.00000626" iyy="0.00040879" iyz="0.00000462" izz="0.00045802"/>

        </inertial>

        <visual>

            <origin xyz="0 0 0" rpy="0 0 0"/>

