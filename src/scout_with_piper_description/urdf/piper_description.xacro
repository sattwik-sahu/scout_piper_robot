<!-- pika gripper (pika_ros pika_gripper_description, official link6 mount) -->
  <link name="gripper_base_link">
    <inertial>
      <origin xyz="0.037477 -8.1437E-07 0.0084053" rpy="0 0 0" />
      <mass value="0.18972" />
      <inertia ixx="0.0002159" ixy="3.3333E-08" ixz="-2.6278E-06" iyy="0.00014308" iyz="1.6782E-08" izz="0.00011036" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://scout_with_piper_description/meshes/gripper_base_link.dae" />
      </geometry>
      <material name="pika_black">
        <color rgba="0.09 0.09 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://scout_with_piper_description/meshes/gripper_base_link.stl" />
      </geometry>
    </collision>
  </link>
  <joint name="joint6_to_gripper_base" type="fixed">
    <origin xyz="0 0 0" rpy="0 -1.57 0" />
    <parent link="piper_link6" />
    <child link="gripper_base_link" />
  </joint>
  <link name="gripper_left_link">
    <inertial>
      <origin xyz="0.033255 -0.014661 -0.0057614" rpy="0 0 0" />
      <mass value="0.033674" />
      <inertia ixx="1.5284E-05" ixy="1.4473E-05" ixz="1.4911E-08" iyy="3.448E-05" iyz="-4.3614E-09" izz="3.9744E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://scout_with_piper_description/meshes/gripper_left_link.dae" />
      </geometry>
      <material name="pika_black">
        <color rgba="0.09 0.09 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://scout_with_piper_description/meshes/gripper_left_link.stl" />
      </geometry>
    </collision>
  </link>
  <joint name="gripper_left_joint" type="prismatic">
    <origin xyz="0.0815 0.08851 0.0064182" rpy="0 0 0" />
    <parent link="gripper_base_link" />
    <child link="gripper_left_link" />
    <axis xyz="0 1 0" />
    <limit lower="-0.05" upper="0" effort="100" velocity="5" />
  </joint>
  <link name="gripper_right_link">
    <inertial>
      <origin xyz="0.033255 0.014661 -0.0058113" rpy="0 0 0" />
      <mass value="0.033674" />
      <inertia ixx="1.5284E-05" ixy="-1.4473E-05" ixz="-1.4956E-08" iyy="3.448E-05" iyz="-4.3614E-09" izz="3.9744E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://scout_with_piper_description/meshes/gripper_right_link.dae" />
      </geometry>
      <material name="pika_black">
        <color rgba="0.09 0.09 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://scout_with_piper_description/meshes/gripper_right_link.stl" />
      </geometry>
    </collision>
  </link>
  <joint name="gripper_right_joint" type="prismatic">
    <origin xyz="0.0815 -0.088529 0.0064182" rpy="0 0 0" />
    <parent link="gripper_base_link" />
    <child link="gripper_right_link" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="0.05" effort="100" velocity="5" />
  </joint>

  <!-- Left camera mounted on the gripper base -->
  <link name="gripper_left_camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.02 0.02 0.02" />
      </geometry>
      <material name="camera_grey">
        <color rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.02 0.02 0.02" />
      </geometry>
    </collision>
  </link>
  <joint name="gripper_left_camera_joint" type="fixed">
    <origin xyz="$(arg left_camera_xyz)" rpy="$(arg left_camera_rpy)" />
    <parent link="gripper_base_link" />
    <child link="gripper_left_camera_link" />
  </joint>

<!-- controller -->

  <xacro:macro name="transmission_block" params="tran_name joint_name motor_name">

    <transmission name="${tran_name}">

        <type>transmission_interface/SimpleTransmission</type>

        <joint name="${joint_name}">

            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>

        </joint>

        <actuator name="$motor_name">

            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>

            <mechanicalReduction>1</mechanicalReduction>

        </actuator>

    </transmission>

  </xacro:macro>



