<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="scout_mini_piper">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import scout_mini_piper urdf file -->
    <xacro:include filename="$(find scout_with_piper_description)/urdf/scout_piper_moveit.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="scout_mini_piper.ros2_control.xacro" />


    <xacro:scout_mini_piper_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
